# Copy to .env for local development: cp .env.example .env
# Never commit .env. Production values live only in Railway environment variables.

# Database (local docker compose service on port 5433).
# Project-specific name on purpose: the generic DATABASE_URL in your shell belongs to
# another project and is ignored here. Outside production the database name must
# start with "leftovers" (enforced in src/lib/database-url.ts).
LEFTOVERS_DATABASE_URL="postgresql://leftovers:leftovers_dev_only@127.0.0.1:5433/leftovers"

# Public base URL of the site, no trailing slash.
APP_URL="http://localhost:3000"

# 32+ random characters. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-output-of-openssl-rand-base64-32"

# Email. "smtp" sends to the local Mailpit inbox (http://localhost:8026).
# Production must use "resend".
MAIL_TRANSPORT="smtp"
SMTP_HOST="127.0.0.1"
SMTP_PORT="1026"
# RESEND_API_KEY=""   # required when MAIL_TRANSPORT=resend
MAIL_FROM="The Leftovers <no-reply@mail.theleftoversband.com>"
MAIL_REPLY_TO="booking@theleftoversband.com"

# trace | debug | info | warn | error
LOG_LEVEL="info"

# Phone/desktop alerts (Web Push). Optional: without these, alerts are email-only.
# Generate with: node -e 'console.log(require("web-push").generateVAPIDKeys())'
# VAPID_PUBLIC_KEY=""
# VAPID_PRIVATE_KEY=""
# VAPID_SUBJECT="mailto:booking@theleftoversband.com"

# Background jobs (reminders, hold warnings, draft cleanup) run automatically in
# production. Set to "true" to run them locally too.
# JOBS_ENABLED="false"
