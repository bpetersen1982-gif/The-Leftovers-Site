// The Leftovers — database schema.
// Auth tables (User, Session, Account, Verification, Passkey, RateLimit) follow the
// field names Better Auth expects; everything else is application data.
// All timestamps are stored in UTC (timestamptz).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MEMBER
}

// ---------------------------------------------------------------- auth

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  role          Role      @default(MEMBER)
  /// Set when an Admin removes the user. Row is kept so the audit log stays intact.
  deactivatedAt DateTime? @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)

  sessions      Session[]
  accounts      Account[]
  passkeys      Passkey[]
  invitesSent   Invite[]     @relation("InviteSender")
  invitesUsed   Invite[]     @relation("InviteAcceptedBy")
  auditEntries  AuditLog[]
  bandMember    BandMember?
  availabilityBlocks       AvailabilityBlock[] @relation("AvailabilityOwner")
  availabilityBlocksAdded  AvailabilityBlock[] @relation("AvailabilityCreator")

  @@index([role, deactivatedAt])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime @db.Timestamptz(3)
  token     String   @unique
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@index([identifier])
  @@map("verification")
}

model Passkey {
  id           String    @id
  name         String?
  publicKey    String
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialID String
  counter      Int
  deviceType   String
  backedUp     Boolean
  transports   String?
  aaguid       String?
  createdAt    DateTime? @default(now()) @db.Timestamptz(3)

  @@index([userId])
  @@index([credentialID])
  @@map("passkey")
}

model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rateLimit")
}

// ---------------------------------------------------------------- invites

model Invite {
  id           String    @id @default(uuid()) @db.Uuid
  email        String
  name         String
  role         Role
  /// SHA-256 of the token in the invite link. The raw token is never stored.
  tokenHash    String    @unique
  expiresAt    DateTime  @db.Timestamptz(3)
  acceptedAt   DateTime? @db.Timestamptz(3)
  revokedAt    DateTime? @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  invitedById  String
  invitedBy    User      @relation("InviteSender", fields: [invitedById], references: [id])
  acceptedById String?
  acceptedBy   User?     @relation("InviteAcceptedBy", fields: [acceptedById], references: [id])

  @@index([email])
  @@map("invite")
}

// ---------------------------------------------------------------- audit

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  /// Null for system actions (e.g. the bootstrap CLI).
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  actorRole  Role?
  action     String
  targetType String
  targetId   String?
  before     Json?
  after      Json?
  requestId  String?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@index([createdAt(sort: Desc)])
  @@index([targetType, targetId])
  @@map("audit_log")
}

// ---------------------------------------------------------------- content

model BandMember {
  id         String   @id @default(uuid()) @db.Uuid
  name       String
  instrument String   @default("")
  /// Content blocks (see src/lib/content/blocks.ts). Empty array = "Bio coming soon".
  bio        Json     @default("[]")
  sortOrder  Int
  isVisible  Boolean  @default(true)
  /// Optional link to a login account. Public profile and permissions are separate.
  userId     String?  @unique
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  version    Int      @default(1)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@index([sortOrder])
  @@map("band_member")
}

model Page {
  /// One of the slugs in src/lib/content/pages.ts.
  slug        String   @id
  title       String
  /// Content blocks (see src/lib/content/blocks.ts).
  content     Json     @default("[]")
  version     Int      @default(1)
  updatedById String?
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@map("page")
}

model SiteSettings {
  /// Singleton row; always 1.
  id             Int      @id @default(1)
  tagline        String   @default("")
  bookingEmail   String   @default("")
  generalEmail   String   @default("")
  copyrightEmail String   @default("")
  /// Array of { platform, url } (see src/lib/content/settings.ts).
  socialLinks    Json     @default("[]")
  version        Int      @default(1)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  @@map("site_settings")
}

// ---------------------------------------------------------------- availability

enum AvailabilityScope {
  /// One band member is out; public sees "Limited availability".
  MEMBER
  /// The whole band is off; public sees "Unavailable" and can't request.
  BAND
}

/// Out-of-office and band-off date ranges (requirements BOOK-19). Dates are calendar
/// dates in America/Chicago, inclusive on both ends; no time component.
model AvailabilityBlock {
  id          String            @id @default(uuid()) @db.Uuid
  scope       AvailabilityScope
  startDate   DateTime          @db.Date
  endDate     DateTime          @db.Date
  /// The member who is out (MEMBER scope). Null for BAND scope.
  userId      String?
  user        User?             @relation("AvailabilityOwner", fields: [userId], references: [id], onDelete: Cascade)
  /// Private: visible to the owner and Admins only, never public.
  note        String            @default("")
  createdById String
  createdBy   User              @relation("AvailabilityCreator", fields: [createdById], references: [id])
  createdAt   DateTime          @default(now()) @db.Timestamptz(3)

  @@index([startDate, endDate])
  @@index([userId])
  @@map("availability_block")
}

// ---------------------------------------------------------------- pricing

enum EventType {
  BAR_CLUB
  FESTIVAL
  WEDDING
  GRADUATION
  PRIVATE_PARTY
  CORPORATE
  OTHER
}

enum DayCategory {
  SUN_THU
  FRI_SAT
  /// Admin-listed dates such as Dec 31 or July 4.
  SPECIAL
}

/// Booking rules (requirements BOOK-3, ELIG-2a, ELIG-4). Singleton row, id = 1.
model PricingSettings {
  id                 Int      @id @default(1)
  minSets            Int      @default(1)
  maxSets            Int      @default(4)
  quoteValidityHours Int      @default(72)
  minNoticeDays      Int      @default(7)
  travelRadiusMiles  Int      @default(60)
  /// Center point for the travel radius, as a ZIP code (default Lincoln).
  originZip          String   @default("68508")
  version            Int      @default(1)
  updatedAt          DateTime @updatedAt @db.Timestamptz(3)

  @@map("pricing_settings")
}

/// One cell of the rate grid. No row = "require a quote" (contact path).
model RateRule {
  id              String      @id @default(uuid()) @db.Uuid
  eventType       EventType
  dayCategory     DayCategory
  ratePerSetCents Int
  updatedAt       DateTime    @updatedAt @db.Timestamptz(3)

  @@unique([eventType, dayCategory])
  @@map("rate_rule")
}

/// Dates priced with the SPECIAL column (requirements RATE-3).
model SpecialDate {
  date      DateTime @id @db.Date
  label     String
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@map("special_date")
}

// ---------------------------------------------------------------- booking

enum BookingRequestKind {
  /// Came through the booking wizard.
  WIZARD
  /// "Contact the band about this date" (date already Pending/Booked) or general booking contact.
  DATE_CONTACT
}

/// Request lifecycle (requirements §6.6).
enum BookingStatus {
  /// Wizard started; contact details saved at step 2 but not submitted (FUN-2).
  IN_PROGRESS
  /// Submitted; no instant quote. The band will reach out.
  AWAITING_CONTACT
  /// Instant or manual quote sent; waiting on the prospect. Expiry is read from the quote.
  QUOTED
  /// Prospect accepted the quote; date is Pending until an Admin confirms.
  ACCEPTED
  DECLINED_BY_PROSPECT
  /// A band member has been in touch.
  CONTACTED
  CONFIRMED
  DECLINED_BY_BAND
  WITHDRAWN
  /// Bumped by an Admin override.
  RELEASED
  CANCELLED
}

enum SoundProvided {
  YES
  NO
  PARTIAL
  UNSURE
}

enum Setting {
  INDOOR
  OUTDOOR
  UNSURE
}

model BookingRequest {
  id               String             @id @default(uuid()) @db.Uuid
  /// Human-friendly reference shown to the prospect, e.g. "LO-7K3M9Q".
  reference        String             @unique
  kind             BookingRequestKind
  status           BookingStatus
  /// Null = flexible / not sure yet.
  eventDate        DateTime?          @db.Date
  /// Local times in the band's timezone, "HH:MM"; end may be after midnight.
  startTime        String?
  endTime          String?
  sets             Int?
  eventType        EventType?
  contactName      String
  email            String
  phone            String
  organization     String             @default("")
  street           String             @default("")
  city             String             @default("")
  state            String             @default("")
  zip              String             @default("")
  attendance       Int?
  setting          Setting?
  soundProvided    SoundProvided?
  message          String             @default("")
  /// Straight-line miles from the travel origin; null if the ZIP wasn't found.
  distanceMiles    Float?
  /// Why no instant quote was offered (internal; see INELIGIBLE_REASON_LABELS).
  ineligibleReasons String[]          @default([])
  /// Another open request, hold, or booking exists for the same date.
  isConflict       Boolean            @default(false)
  /// SHA-256 of the prospect's private-link token.
  accessTokenHash  String             @unique
  /// Prospect's optional note when accepting/declining (max 250 chars).
  responseNote     String             @default("")
  respondedAt      DateTime?          @db.Timestamptz(3)
  submittedAt      DateTime?          @db.Timestamptz(3)
  version          Int                @default(1)
  createdAt        DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime           @updatedAt @db.Timestamptz(3)

  quotes           Quote[]
  claim            DateClaim?
  events           BookingEvent[]

  @@index([status, eventDate])
  @@index([eventDate])
  @@index([email, createdAt])
  @@map("booking_request")
}

/// Price snapshot (requirements BOOK-5). Later rate changes never alter a quote.
model Quote {
  id              String         @id @default(uuid()) @db.Uuid
  requestId       String         @db.Uuid
  request         BookingRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  eventType       EventType
  dayCategory     DayCategory
  ratePerSetCents Int
  sets            Int
  totalCents      Int
  expiresAt       DateTime       @db.Timestamptz(3)
  /// Set when a newer quote replaces this one.
  supersededAt    DateTime?      @db.Timestamptz(3)
  /// Null = generated automatically by the wizard.
  createdById     String?
  createdAt       DateTime       @default(now()) @db.Timestamptz(3)

  @@index([requestId, createdAt])
  @@map("quote")
}

enum ClaimKind {
  PENDING
  BOOKED
}

/// At most one claim per date (requirements BOOK-16, BOOK-27). The unique index is what
/// makes two simultaneous accepts for the same date impossible.
model DateClaim {
  id        String         @id @default(uuid()) @db.Uuid
  date      DateTime       @unique @db.Date
  kind      ClaimKind
  requestId String         @unique @db.Uuid
  request   BookingRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt DateTime       @updatedAt @db.Timestamptz(3)

  @@map("date_claim")
}

enum BookingEventKind {
  STATUS
  NOTE
  CONTACTED
}

/// Timeline of a request: status changes, internal notes, "contacted" logs (BOOK-13).
model BookingEvent {
  id         String           @id @default(uuid()) @db.Uuid
  requestId  String           @db.Uuid
  request    BookingRequest   @relation(fields: [requestId], references: [id], onDelete: Cascade)
  kind       BookingEventKind
  fromStatus BookingStatus?
  toStatus   BookingStatus?
  body       String           @default("")
  /// Null = the prospect or the system.
  authorId   String?
  createdAt  DateTime         @default(now()) @db.Timestamptz(3)

  @@index([requestId, createdAt])
  @@map("booking_event")
}
