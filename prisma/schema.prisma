// The Leftovers — database schema.
// Auth tables (User, Session, Account, Verification, Passkey, RateLimit) follow the
// field names Better Auth expects; everything else is application data.
// All timestamps are stored in UTC (timestamptz).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MEMBER
}

// ---------------------------------------------------------------- auth

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  role          Role      @default(MEMBER)
  /// Set when an Admin removes the user. Row is kept so the audit log stays intact.
  deactivatedAt DateTime? @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)

  sessions      Session[]
  accounts      Account[]
  passkeys      Passkey[]
  invitesSent   Invite[]     @relation("InviteSender")
  invitesUsed   Invite[]     @relation("InviteAcceptedBy")
  auditEntries  AuditLog[]
  bandMember    BandMember?
  availabilityBlocks       AvailabilityBlock[] @relation("AvailabilityOwner")
  availabilityBlocksAdded  AvailabilityBlock[] @relation("AvailabilityCreator")
  pushSubscriptions        PushSubscription[]
  photosUploaded           Photo[]             @relation("PhotoUploader")
  photosDecided            Photo[]             @relation("PhotoDecider")
  photoRemovalsRequested   Photo[]             @relation("PhotoRemovalRequester")
  albumsCreated            Album[]
  takedownsActed           TakedownNotice[]    @relation("TakedownActor")
  takedownsResolved        TakedownNotice[]    @relation("TakedownResolver")
  videosUploaded           Video[]             @relation("VideoUploader")
  videoRemovalsRequested   Video[]             @relation("VideoRemovalRequester")
  /// NOT-5: booking alerts by email / phone push. Both on by default.
  bookingEmailAlerts       Boolean             @default(true)
  bookingPushAlerts        Boolean             @default(true)

  @@index([role, deactivatedAt])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime @db.Timestamptz(3)
  token     String   @unique
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@index([identifier])
  @@map("verification")
}

model Passkey {
  id           String    @id
  name         String?
  publicKey    String
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialID String
  counter      Int
  deviceType   String
  backedUp     Boolean
  transports   String?
  aaguid       String?
  createdAt    DateTime? @default(now()) @db.Timestamptz(3)

  @@index([userId])
  @@index([credentialID])
  @@map("passkey")
}

model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rateLimit")
}

// ---------------------------------------------------------------- invites

model Invite {
  id           String    @id @default(uuid()) @db.Uuid
  email        String
  name         String
  role         Role
  /// SHA-256 of the token in the invite link. The raw token is never stored.
  tokenHash    String    @unique
  expiresAt    DateTime  @db.Timestamptz(3)
  acceptedAt   DateTime? @db.Timestamptz(3)
  revokedAt    DateTime? @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  invitedById  String
  invitedBy    User      @relation("InviteSender", fields: [invitedById], references: [id])
  acceptedById String?
  acceptedBy   User?     @relation("InviteAcceptedBy", fields: [acceptedById], references: [id])

  @@index([email])
  @@map("invite")
}

// ---------------------------------------------------------------- audit

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  /// Null for system actions (e.g. the bootstrap CLI).
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  actorRole  Role?
  action     String
  targetType String
  targetId   String?
  before     Json?
  after      Json?
  requestId  String?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@index([createdAt(sort: Desc)])
  @@index([targetType, targetId])
  @@map("audit_log")
}

// ---------------------------------------------------------------- content

model BandMember {
  id         String   @id @default(uuid()) @db.Uuid
  name       String
  instrument String   @default("")
  /// Content blocks (see src/lib/content/blocks.ts). Empty array = "Bio coming soon".
  bio        Json     @default("[]")
  sortOrder  Int
  isVisible  Boolean  @default(true)
  /// Optional link to a login account. Public profile and permissions are separate.
  userId     String?  @unique
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  version    Int      @default(1)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@index([sortOrder])
  @@map("band_member")
}

model Page {
  /// One of the slugs in src/lib/content/pages.ts.
  slug        String   @id
  title       String
  /// Content blocks (see src/lib/content/blocks.ts).
  content     Json     @default("[]")
  version     Int      @default(1)
  updatedById String?
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@map("page")
}

model SiteSettings {
  /// Singleton row; always 1.
  id             Int      @id @default(1)
  tagline        String   @default("")
  bookingEmail   String   @default("")
  generalEmail   String   @default("")
  copyrightEmail String   @default("")
  /// Array of { platform, url } (see src/lib/content/settings.ts).
  socialLinks    Json     @default("[]")
  version        Int      @default(1)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  @@map("site_settings")
}

// ---------------------------------------------------------------- availability

enum AvailabilityScope {
  /// One band member is out; public sees "Limited availability".
  MEMBER
  /// The whole band is off; public sees "Unavailable" and can't request.
  BAND
}

/// Out-of-office and band-off date ranges (requirements BOOK-19). Dates are calendar
/// dates in America/Chicago, inclusive on both ends; no time component.
model AvailabilityBlock {
  id          String            @id @default(uuid()) @db.Uuid
  scope       AvailabilityScope
  startDate   DateTime          @db.Date
  endDate     DateTime          @db.Date
  /// The member who is out (MEMBER scope). Null for BAND scope.
  userId      String?
  user        User?             @relation("AvailabilityOwner", fields: [userId], references: [id], onDelete: Cascade)
  /// Private: visible to the owner and Admins only, never public.
  note        String            @default("")
  createdById String
  createdBy   User              @relation("AvailabilityCreator", fields: [createdById], references: [id])
  createdAt   DateTime          @default(now()) @db.Timestamptz(3)

  @@index([startDate, endDate])
  @@index([userId])
  @@map("availability_block")
}

// ---------------------------------------------------------------- pricing

enum EventType {
  BAR_CLUB
  FESTIVAL
  WEDDING
  GRADUATION
  PRIVATE_PARTY
  CORPORATE
  OTHER
}

enum DayCategory {
  SUN_THU
  FRI_SAT
  /// Admin-listed dates such as Dec 31 or July 4.
  SPECIAL
}

/// Booking rules (requirements BOOK-3, ELIG-2a, ELIG-4). Singleton row, id = 1.
model PricingSettings {
  id                 Int      @id @default(1)
  minSets            Int      @default(1)
  maxSets            Int      @default(4)
  quoteValidityHours Int      @default(72)
  minNoticeDays      Int      @default(7)
  travelRadiusMiles  Int      @default(60)
  /// Center point for the travel radius, as a ZIP code (default Lincoln).
  originZip          String   @default("68508")
  version            Int      @default(1)
  updatedAt          DateTime @updatedAt @db.Timestamptz(3)

  @@map("pricing_settings")
}

/// One cell of the rate grid. No row = "require a quote" (contact path).
model RateRule {
  id              String      @id @default(uuid()) @db.Uuid
  eventType       EventType
  dayCategory     DayCategory
  ratePerSetCents Int
  updatedAt       DateTime    @updatedAt @db.Timestamptz(3)

  @@unique([eventType, dayCategory])
  @@map("rate_rule")
}

/// Dates priced with the SPECIAL column (requirements RATE-3).
model SpecialDate {
  date      DateTime @id @db.Date
  label     String
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@map("special_date")
}

// ---------------------------------------------------------------- booking

enum BookingRequestKind {
  /// Came through the booking wizard.
  WIZARD
  /// "Contact the band about this date" (date already Pending/Booked) or general booking contact.
  DATE_CONTACT
}

/// Request lifecycle (requirements §6.6).
enum BookingStatus {
  /// Wizard started; contact details saved at step 2 but not submitted (FUN-2).
  IN_PROGRESS
  /// Submitted; no instant quote. The band will reach out.
  AWAITING_CONTACT
  /// Instant or manual quote sent; waiting on the prospect. Expiry is read from the quote.
  QUOTED
  /// Prospect accepted the quote; date is Pending until an Admin confirms.
  ACCEPTED
  DECLINED_BY_PROSPECT
  /// A band member has been in touch.
  CONTACTED
  CONFIRMED
  DECLINED_BY_BAND
  WITHDRAWN
  /// Bumped by an Admin override.
  RELEASED
  CANCELLED
}

enum SoundProvided {
  YES
  NO
  PARTIAL
  UNSURE
}

enum Setting {
  INDOOR
  OUTDOOR
  UNSURE
}

model BookingRequest {
  id               String             @id @default(uuid()) @db.Uuid
  /// Human-friendly reference shown to the prospect, e.g. "LO-7K3M9Q".
  reference        String             @unique
  kind             BookingRequestKind
  status           BookingStatus
  /// Null = flexible / not sure yet.
  eventDate        DateTime?          @db.Date
  /// Local times in the band's timezone, "HH:MM"; end may be after midnight.
  startTime        String?
  endTime          String?
  sets             Int?
  eventType        EventType?
  contactName      String
  email            String
  phone            String
  organization     String             @default("")
  street           String             @default("")
  city             String             @default("")
  state            String             @default("")
  zip              String             @default("")
  attendance       Int?
  setting          Setting?
  soundProvided    SoundProvided?
  message          String             @default("")
  /// Straight-line miles from the travel origin; null if the ZIP wasn't found.
  distanceMiles    Float?
  /// Why no instant quote was offered (internal; see INELIGIBLE_REASON_LABELS).
  ineligibleReasons String[]          @default([])
  /// Another open request, hold, or booking exists for the same date.
  isConflict       Boolean            @default(false)
  /// SHA-256 of the prospect's private-link token.
  accessTokenHash  String             @unique
  /// Prospect's optional note when accepting/declining (max 250 chars).
  responseNote     String             @default("")
  respondedAt      DateTime?          @db.Timestamptz(3)
  submittedAt      DateTime?          @db.Timestamptz(3)
  /// Set when an Admin confirms (requirements BOOK-15). Admin-only, like quotes.
  agreedPriceCents Int?
  /// Load-in time, "HH:MM" local.
  loadInTime       String?
  confirmedAt      DateTime?          @db.Timestamptz(3)
  confirmedById    String?
  /// BOOK-17 reminders for accepted quotes awaiting confirmation.
  reminder24SentAt DateTime?          @db.Timestamptz(3)
  reminder72SentAt DateTime?          @db.Timestamptz(3)
  version          Int                @default(1)
  createdAt        DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime           @updatedAt @db.Timestamptz(3)

  quotes           Quote[]
  claim            DateClaim?
  events           BookingEvent[]

  @@index([status, eventDate])
  @@index([eventDate])
  @@index([email, createdAt])
  @@map("booking_request")
}

/// Price snapshot (requirements BOOK-5). Later rate changes never alter a quote.
model Quote {
  id              String         @id @default(uuid()) @db.Uuid
  requestId       String         @db.Uuid
  request         BookingRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  eventType       EventType
  dayCategory     DayCategory
  ratePerSetCents Int
  sets            Int
  totalCents      Int
  expiresAt       DateTime       @db.Timestamptz(3)
  /// Set when a newer quote replaces this one.
  supersededAt    DateTime?      @db.Timestamptz(3)
  /// Null = generated automatically by the wizard.
  createdById     String?
  createdAt       DateTime       @default(now()) @db.Timestamptz(3)

  @@index([requestId, createdAt])
  @@map("quote")
}

enum ClaimKind {
  PENDING
  BOOKED
}

/// At most one claim per date (requirements BOOK-16, BOOK-27). The unique index is what
/// makes two simultaneous accepts for the same date impossible.
model DateClaim {
  id        String         @id @default(uuid()) @db.Uuid
  date      DateTime       @unique @db.Date
  kind      ClaimKind
  requestId String         @unique @db.Uuid
  request   BookingRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  /// Manual Admin holds expire (BOOK-17); accepted quotes and bookings don't (null).
  expiresAt DateTime?      @db.Timestamptz(3)
  /// Null = created by the prospect accepting a quote.
  createdById String?
  /// Set when Admins were warned that a hold expires soon.
  expiryWarnedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt DateTime       @updatedAt @db.Timestamptz(3)

  @@map("date_claim")
}

enum BookingEventKind {
  STATUS
  NOTE
  CONTACTED
  /// An email sent to the prospect from the site (reply, decline, quote, confirmation).
  EMAIL
}

/// Timeline of a request: status changes, internal notes, "contacted" logs (BOOK-13).
model BookingEvent {
  id         String           @id @default(uuid()) @db.Uuid
  requestId  String           @db.Uuid
  request    BookingRequest   @relation(fields: [requestId], references: [id], onDelete: Cascade)
  kind       BookingEventKind
  fromStatus BookingStatus?
  toStatus   BookingStatus?
  body       String           @default("")
  /// Null = the prospect or the system.
  authorId   String?
  createdAt  DateTime         @default(now()) @db.Timestamptz(3)

  @@index([requestId, createdAt])
  @@map("booking_event")
}

// ---------------------------------------------------------------- notifications

/// A browser/device that accepted Web Push for a band user (requirements NOT-1).
model PushSubscription {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint      String    @unique
  p256dh        String
  auth          String
  /// Friendly name so people can tell devices apart ("iPhone", "Mac").
  label         String    @default("This device")
  lastSuccessAt DateTime? @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)

  @@index([userId])
  @@map("push_subscription")
}

// ---------------------------------------------------------------- photos

/// Lifecycle of a photo (requirements APR-1, APR-2, APR-6, MED-1..4). Only APPROVED is public.
enum PhotoStatus {
  /// Upload URL issued; waiting for the browser to finish sending the file.
  UPLOADING
  /// File received; signature check, HEIC conversion, metadata strip, and resizing in progress.
  PROCESSING
  /// Processed and private; the uploader adds alt text etc. before submitting.
  DRAFT
  /// Submitted by a Band Member; waiting on an Admin.
  PENDING_REVIEW
  APPROVED
  REJECTED
  /// Was public; a Member or Admin took it off the site (APR-7). An Admin deletes it or puts it back.
  DELETION_REQUESTED
  /// Unpublished by an Admin after a copyright notice (LEG-3). Only an Admin can restore it.
  TAKEN_DOWN
  /// The file couldn't be used (wrong type, corrupt, too large). Original already deleted.
  FAILED
}

model Photo {
  id               String      @id @default(uuid()) @db.Uuid
  status           PhotoStatus @default(UPLOADING)
  uploaderId       String
  uploader         User        @relation("PhotoUploader", fields: [uploaderId], references: [id])
  /// Display only (sanitized), so uploaders can tell their files apart. Never used as a storage key.
  originalFilename String
  /// What the browser said it was sending; checked against the file's signature on completion.
  declaredType     String
  declaredSize     Int
  /// Private bucket key of the uploaded original. Deleted after processing.
  originalKey      String      @unique
  /// Upload URL expiry; abandoned uploads are cleaned up after this.
  uploadExpiresAt  DateTime    @db.Timestamptz(3)
  width            Int?
  height           Int?
  /// Processed files in the private bucket: [{ kind, width, height, key, contentType, bytes }].
  variants         Json        @default("[]")
  /// Tiny base64 WebP shown while the real image loads.
  blurDataUrl      String?
  /// Public bucket key prefix while APPROVED (random per publish, so old URLs never come back).
  publicPrefix     String?     @unique
  altText          String      @default("")
  caption          String      @default("")
  credit           String      @default("")
  failureReason    String?
  submittedAt      DateTime?   @db.Timestamptz(3)
  decidedAt        DateTime?   @db.Timestamptz(3)
  decidedById      String?
  decidedBy        User?       @relation("PhotoDecider", fields: [decidedById], references: [id])
  decidedByRole    Role?
  rejectionReason  String?
  publishedAt      DateTime?   @db.Timestamptz(3)
  removalRequestedAt     DateTime? @db.Timestamptz(3)
  removalRequestedById   String?
  removalRequestedBy     User?     @relation("PhotoRemovalRequester", fields: [removalRequestedById], references: [id])
  removalRequestedByRole Role?
  removalReason          String?
  /// Optimistic concurrency (APR-11): every state change bumps it.
  version          Int         @default(1)
  createdAt        DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime    @updatedAt @db.Timestamptz(3)

  albumItems       AlbumItem[]
  coverOf          Album[]     @relation("AlbumCover")

  @@index([status, publishedAt(sort: Desc)])
  @@index([status, uploadExpiresAt])
  @@index([uploaderId, status])
  @@map("photo")
}

// ---------------------------------------------------------------- jobs

/// Last successful run of a once-a-day job (e.g. the review digest), so restarts don't resend it.
model JobState {
  name      String   @id
  lastRunAt DateTime @db.Timestamptz(3)

  @@map("job_state")
}

// ---------------------------------------------------------------- albums

/// A gallery of published photos, e.g. one show (requirements MED-5).
model Album {
  id           String      @id @default(uuid()) @db.Uuid
  /// URL path, set once from the title so shared links never break.
  slug         String      @unique
  title        String
  description  String      @default("")
  /// Optional show/event date (calendar date, band time zone).
  eventDate    DateTime?   @db.Date
  /// Hidden albums are band-only while they're being put together.
  isPublic     Boolean     @default(false)
  /// Must be one of the album's photos; falls back to the first public photo when unset or not public.
  coverPhotoId String?     @db.Uuid
  coverPhoto   Photo?      @relation("AlbumCover", fields: [coverPhotoId], references: [id], onDelete: SetNull)
  createdById  String
  createdBy    User        @relation(fields: [createdById], references: [id])
  version      Int         @default(1)
  createdAt    DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime    @updatedAt @db.Timestamptz(3)
  items        AlbumItem[]

  @@index([isPublic, eventDate(sort: Desc)])
  @@map("album")
}

model AlbumItem {
  albumId   String   @db.Uuid
  album     Album    @relation(fields: [albumId], references: [id], onDelete: Cascade)
  /// Deleting a photo for good removes it from every album.
  photoId   String   @db.Uuid
  photo     Photo    @relation(fields: [photoId], references: [id], onDelete: Cascade)
  sortOrder Int
  addedAt   DateTime @default(now()) @db.Timestamptz(3)

  @@id([albumId, photoId])
  @@index([albumId, sortOrder])
  @@index([photoId])
  @@map("album_item")
}

// ---------------------------------------------------------------- copyright takedowns

enum MediaKind {
  PHOTO
  VIDEO
}

enum TakedownResolution {
  RESTORED
  DELETED
}

/// A copyright notice an Admin acted on (requirements LEG-3). Kept permanently, even after
/// the photo or video is deleted, so there's no foreign key to the media.
model TakedownNotice {
  id           String              @id @default(uuid()) @db.Uuid
  mediaKind    MediaKind
  mediaId      String              @db.Uuid
  /// What the item was (alt text / title) at the time, since it may be deleted later.
  mediaLabel   String
  senderName   String
  senderEmail  String
  workClaimed  String
  /// Date the notice arrived (band time zone).
  receivedOn   DateTime            @db.Date
  notes        String              @default("")
  actedById    String
  actedBy      User                @relation("TakedownActor", fields: [actedById], references: [id])
  actedByRole  Role
  createdAt    DateTime            @default(now()) @db.Timestamptz(3)
  resolution   TakedownResolution?
  resolvedAt   DateTime?           @db.Timestamptz(3)
  resolvedById String?
  resolvedBy   User?               @relation("TakedownResolver", fields: [resolvedById], references: [id])

  @@index([mediaKind, mediaId])
  @@index([createdAt(sort: Desc)])
  @@map("takedown_notice")
}

// ---------------------------------------------------------------- video (Cloudflare Stream)

/// Lifecycle of a video (requirements MED-6..MED-10, APR-7, LEG-3). Only PUBLISHED is public.
enum VideoStatus {
  /// Upload URL issued; the browser is sending the file to Stream (resumable).
  UPLOADING
  /// Stream has the file and is encoding it.
  PROCESSING
  /// Encoded and private; an Admin adds a title etc. and publishes.
  READY
  PUBLISHED
  /// Was public; taken off the site (APR-7). An Admin deletes it or puts it back.
  DELETION_REQUESTED
  /// Unpublished after a copyright notice (LEG-3).
  TAKEN_DOWN
  /// Stream couldn't use the file (not a video, corrupt, too long).
  FAILED
}

model Video {
  id                     String      @id @default(uuid()) @db.Uuid
  /// Cloudflare Stream video id.
  streamUid              String      @unique
  status                 VideoStatus @default(UPLOADING)
  uploaderId             String
  uploader               User        @relation("VideoUploader", fields: [uploaderId], references: [id])
  /// Display only (sanitized).
  originalFilename       String
  sizeBytes              BigInt
  uploadExpiresAt        DateTime    @db.Timestamptz(3)
  durationSeconds        Float?
  width                  Int?
  height                 Int?
  /// "https://customer-<code>.cloudflarestream.com", learned from Stream once processed.
  playbackOrigin         String?
  failureReason          String?
  /// Whether Stream currently allows unsigned playback. True only while PUBLISHED;
  /// the video job re-locks any video where this drifted (e.g. a failed API call).
  streamPublic           Boolean     @default(false)
  title                  String      @default("")
  description            String      @default("")
  /// Poster frame (MED-8): seconds into the video.
  posterSeconds          Float       @default(0)
  /// Language of uploaded WebVTT captions, if any (MED-8, A11Y-3).
  captionsLanguage       String?
  publishedAt            DateTime?   @db.Timestamptz(3)
  removalRequestedAt     DateTime?   @db.Timestamptz(3)
  removalRequestedById   String?
  removalRequestedBy     User?       @relation("VideoRemovalRequester", fields: [removalRequestedById], references: [id])
  removalRequestedByRole Role?
  removalReason          String?
  version                Int         @default(1)
  createdAt              DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime    @updatedAt @db.Timestamptz(3)

  @@index([status, publishedAt(sort: Desc)])
  @@index([status, updatedAt])
  @@map("video")
}
